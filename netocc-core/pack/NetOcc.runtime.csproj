<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NetOcc.runtime.<rid>: the natives of one RID (artifacts/runtimes/<rid>/native, from build.py native) with their
    license notices. build.py pack packs it once per RID (-p:NetOccRid=<rid>); the NetOcc package depends on all of them.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <NetOccRid Condition="'$(NetOccRid)' == ''">win-x64</NetOccRid>
    <PackageId>NetOcc.runtime.$(NetOccRid)</PackageId>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <Authors>Paul Büchner</Authors>
    <Copyright>Copyright (c) 2026 Paul Büchner</Copyright>
    <Description>Native libraries of NetOcc for $(NetOccRid): the NetOcc libraries and OCCT 8.0.1 with its dependencies. Referenced by the NetOcc package; not meant to be installed alone.</Description>
    <PackageTags>occt;opencascade;cad;native</PackageTags>
    <PackageProjectUrl>https://github.com/paulbuechner/netocc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/paulbuechner/netocc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>THIRD-PARTY-NOTICES.txt</PackageLicenseFile>
    <!-- natives only: no assembly, no dependencies (NU5128: lib/ placeholders without dependency groups) -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NetOccStage>$(MSBuildThisFileDirectory)..\artifacts\runtimes\$(NetOccRid)</NetOccStage>
  </PropertyGroup>

  <!-- PackagePath with forward slashes: CI packs on Linux, where a trailing backslash gives entries like native//libX.so -->
  <ItemGroup>
    <None Include="$(NetOccStage)\native\*" Pack="true" PackagePath="runtimes/$(NetOccRid)/native/" Visible="false" />
    <None Include="$(NetOccStage)\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" Visible="false" />
    <!-- empty lib/ placeholders: compatible with .NET Framework 3.5+ and netstandard2.0 consumers (.NET 6+ included) -->
    <None Include="_._" Pack="true" PackagePath="lib/net35/;lib/netstandard2.0/" Visible="false" />
    <!-- Windows only: .NET Framework ignores runtimes/, so the targets copy the natives into x64\ or x86\ next to the app -->
    <None Include="$(PackageId).targets" Condition="Exists('$(PackageId).targets')" Pack="true" PackagePath="build/net35/;buildTransitive/net35/" />
  </ItemGroup>

  <Target Name="NetOccCheckStage" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(NetOccStage)\native')" Text="No natives in $(NetOccStage)\native: run build.py native for $(NetOccRid) first." />
  </Target>

</Project>

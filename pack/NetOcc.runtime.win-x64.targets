<Project>

  <!--
    .NET Framework apps ignore runtimes\<rid>\native: copy the win-x64 natives into x64\ next to the app, where
    NetOcc's loader looks in a 64-bit process. .NET (Core) apps get them from runtimes\ and skip this.
  -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <None Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-x64\native\*" Link="x64\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>

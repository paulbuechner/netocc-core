<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Avalonia 12 viewer: OcctViewer in a NativeControlHost (Windows). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NetOcc.Viewer.Avalonia</RootNamespace>
    <AssemblyName>NetOcc.Viewer.Avalonia</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetOcc.Viewer\NetOcc.Viewer.csproj" />
  </ItemGroup>

</Project>

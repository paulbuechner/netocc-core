<Window x:Class="NetOcc.Viewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetOcc.Viewer.Wpf"
        Title="NetOcc Viewer (WPF)" Width="1100" Height="750"
        Loaded="Window_Loaded" Closed="Window_Closed">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open STEP..." Click="Open_Click" />
        <MenuItem Header="Open _sample" Click="OpenSample_Click" />
        <Separator />
        <MenuItem Header="E_xit" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Fit all" Click="FitAll_Click" />
      </MenuItem>
    </Menu>
    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock x:Name="Status" Text="Open a STEP file. Left button: rotate, middle: pan, right or wheel: zoom." />
    </StatusBar>
    <local:ViewerHost x:Name="Host" />
  </DockPanel>
</Window>

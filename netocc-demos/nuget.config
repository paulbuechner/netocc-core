<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- NetOcc* from netocc-core's pack output only, everything else from nuget.org -->
  <packageSources>
    <clear />
    <add key="local" value="../netocc-core/artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="NetOcc" />
      <package pattern="NetOcc.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
